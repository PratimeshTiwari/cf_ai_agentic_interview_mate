{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-ai-agentic-interview-mate",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "class_name": "InterviewAgent", "name": "InterviewAgent" },
      { "class_name": "UserAgent", "name": "UserAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["InterviewAgent", "UserAgent"] }
  ],
  "workflows": [
    {
      "name": "interview-report",
      "binding": "REPORT_WORKFLOW",
      "class_name": "InterviewReportWorkflow"
    }
  ],
  // 768-dim cosine index for memory embeddings (see README for setup)
  "vectorize": [
    {
      "binding": "MEMORY_INDEX",
      "index_name": "interview-memories",
      "remote": true
    }
  ],
  "vars": {
    // "openai" (GPT-4o, needs OPENAI_API_KEY) or "workers-ai" (Llama 3.3).
    // With no OPENAI_API_KEY set, the app falls back to Workers AI.
    "LLM_PROVIDER": "openai",
    // Optional: name of an AI Gateway in your account to route LLM calls through.
    "AI_GATEWAY_ID": ""
  }
}
